# Packages installed flat into the squashfs chroot. No container payload
# is packed in - every tool the deploy flow needs runs directly on the
# live OS. Grouped by why each package is here; sizes are watched
# against the 100-300 MiB target the CI workflow reports.

# live-boot supplies the initrd scripts that DHCP the NIC, fetch the
# squashfs over HTTP (the fetch= cmdline parameter kezio's GRUB template
# emits), overlay a writable tmpfs, and pivot into it - this is why the
# image is built with live-build rather than a hand-rolled dracut
# module: live-boot already implements exactly this initrd behavior.
live-boot

# Disk cloning and partitioning the deploy flow drives directly. sid
# tracks current partclone releases; a stable release lags too far
# behind for the file systems the deploy flow needs to clone (the same
# reason docker/ingest/Dockerfile pins sid, not sid-slim's stable counterpart).
partclone
gdisk
util-linux
fdisk
dosfstools
e2fsprogs
efibootmgr

# qemu-guest-agent is deliberately NOT listed here. The KubeVirt e2e
# lanes (.github/workflows/e2e-kubevirt-reusable.yml and its BMC/
# multisite variants) inject qemu-guest-agent straight into the
# *deployed* target disk image before boot, independent of this live
# image's package set - see e2e-kubevirt-reusable.yml's "Customize the
# Ubuntu cloud image" step and its "the live environment never runs
# qemu-guest-agent" comment on the layer-2 boot-wait step. The live
# environment itself is only ever queried through the kezio control
# plane (Machine status), never through QGA, so shipping the package
# here would be squashfs weight with no reader.

# systemd-networkd (part of the systemd package, already pulled in by
# live-boot's own dependencies) brings up DHCP on every NIC - see
# config/includes.chroot.static's networkd .network file. systemd-resolved
# is its own package, not pulled in by anything above, but
# hooks/live/0200-enable-networkd.hook.chroot enables its unit alongside
# networkd's - listed explicitly here so that unit exists by the time
# that hook runs.
systemd-resolved

# openssh-server ships installed but disabled by default - see
# hooks/live/0100-disable-ssh.hook.chroot. It stays available so a
# machine can be entered for debugging without rebuilding the image, but
# emitting an ssh-enabled live image out of the CI build alone must
# never happen.
openssh-server
