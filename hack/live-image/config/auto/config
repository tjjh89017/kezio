#!/bin/sh
# live-build reads this script's `lb config` invocation as the recorded,
# reproducible definition of the image: every flag lives here in the
# repository, not typed at a shell prompt, so a rebuild from the same
# commit reproduces the same configuration. hack/live-image/build.sh
# runs `lb config` with no extra flags of its own for that reason - this
# file is the single source of truth.
#
# --chroot-squashfs-compression-type xz: live-build's own build script
# (scripts/build/binary_rootfs) already falls back to "-comp xz" for
# mksquashfs when this is left unset, so this flag changes no build
# behavior today - it exists to pin that choice explicitly against the
# 100-300 MiB filesystem.squashfs target the CI workflow reports,
# instead of depending on a default that a future live-build release
# could change. xz costs more CPU time to compress than gzip (live-build's
# other implicit default elsewhere), which is a fine tradeoff for a
# release-gated CI build. See also config/rootfs/excludes, which drops
# documentation/man/locale data from the squashfs at packing time - the
# other lever against that same target.
#
# --parent-archive-areas duplicates --archive-areas: this is not a
# derivative build (no --derivative flag), so the actual /etc/apt/
# sources.list live-build writes into the chroot is built from
# LB_PARENT_ARCHIVE_AREAS, not LB_ARCHIVE_AREAS - the latter only feeds
# a derivative's own second source line, unused here. Without this,
# --archive-areas alone silently leaves non-free-firmware absent from
# the chroot's actual apt sources (verified against live-build's
# Create_apt_sources_list).
set -e

lb config noauto \
	--architectures amd64 \
	--distribution sid \
	--archive-areas "main non-free-firmware" \
	--parent-archive-areas "main non-free-firmware" \
	--binary-images iso-hybrid \
	--linux-packages "linux-image" \
	--debian-installer none \
	--apt-recommends false \
	--firmware-chroot false \
	--memtest none \
	--win32-loader false \
	--chroot-squashfs-compression-type xz \
	"${@}"
