#!/bin/sh
# Runs inside the chroot during `lb build`. Enables kezio-agent.service
# (config/includes.chroot.static/lib/systemd/system) so the live OS runs
# the kezio-agent binary automatically on every boot. build.sh's
# build_agent step places that binary at
# config/includes.chroot/usr/local/bin/kezio-agent before `lb build` runs;
# this hook only wires it into the boot sequence.
set -eu

systemctl enable kezio-agent.service
